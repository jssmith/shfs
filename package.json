{
  "name": "agent-drive",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "server",
    "cli",
    "test"
  ],
  "scripts": {
    "build": "tsc -b && cp server/src/store/*.sql server/dist/store/",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:invariants": "INVARIANT_RUNS=2000 vitest run server/src/merge/invariants.test.ts",
    "test:e2e": "vitest run test/e2e"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "fast-check": "^4.11.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  }
}
