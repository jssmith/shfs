[Unit]
Description=Ollama (local models for the ring check), localhost only
After=network-online.target local-fs.target
RequiresMountsFor=@AGENT_DRIVE_DATA@

[Service]
Type=simple
User=ollama
Group=ollama
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=@AGENT_DRIVE_DATA@/ollama
ExecStart=/usr/local/bin/ollama serve
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
