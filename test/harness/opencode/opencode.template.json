{
  "$schema": "https://opencode.ai/config.json",
  "model": "fireworks/${OC_MODEL}",
  "small_model": "fireworks/${OC_MODEL}",
  "provider": {
    "fireworks": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Fireworks",
      "options": {
        "baseURL": "https://api.fireworks.ai/inference/v1",
        "apiKey": "${OC_API_KEY}"
      },
      "models": {
        "accounts/fireworks/models/kimi-k3": { "name": "Kimi K3", "tool_call": true },
        "accounts/fireworks/models/glm-5p3": { "name": "GLM 5.3", "tool_call": true }
      }
    }
  },
  "mcp": {
    "drive": {
      "type": "remote",
      "url": "${AGENT_DRIVE_MCP_URL}",
      "enabled": true,
      "oauth": {}
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "deny"
  },
  "autoupdate": false,
  "share": "disabled"
}
